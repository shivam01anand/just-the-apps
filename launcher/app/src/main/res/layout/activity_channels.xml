<?xml version="1.0" encoding="utf-8"?>
<!-- One person's channels (ChannelsActivity). Everything hangs off one left edge: the film he's on fills the top of
     the screen, its name, year, cast and app on the left; under it, the channels as rows, the one he's on in full
     and the next peeking in below, so Down goes down. Sized for a 960 x 540 dp screen (1080p). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night"
    android:clipChildren="false">

    <ImageView android:id="@+id/stillA" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/stillB" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:alpha="0" android:importantForAccessibility="no" />
    <View android:id="@+id/scrimLeft" android:layout_width="match_parent" android:layout_height="match_parent" />
    <View android:id="@+id/scrimBottom" android:layout_width="match_parent" android:layout_height="330dp" android:layout_gravity="bottom" />
    <View android:id="@+id/scrimTop" android:layout_width="match_parent" android:layout_height="90dp" android:layout_gravity="top" />

    <LinearLayout android:id="@+id/hero" android:layout_width="500dp" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_marginStart="56dp" android:layout_marginTop="40dp"
        android:orientation="vertical">
        <TextView android:id="@+id/kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/mukta_semibold" android:textColor="@color/brass" android:textSize="14sp" />
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:fontFamily="@font/rozha_one" android:lineSpacingMultiplier="0.92"
            android:maxLines="2" android:textColor="@color/ivory" android:textSize="50sp" />
        <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:ellipsize="end" android:fontFamily="@font/mukta_medium" android:maxLines="1"
            android:textColor="@color/ivory_dim" android:textSize="15sp" />
        <TextView android:id="@+id/plot" android:layout_width="480dp" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:ellipsize="end" android:fontFamily="@font/mukta_regular"
            android:lineSpacingMultiplier="1.1" android:maxLines="2" android:textColor="#DCF3EBDD" android:textSize="14.5sp" />
        <LinearLayout android:id="@+id/act" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/ok_circle"
                android:fontFamily="@font/mukta_bold" android:gravity="center" android:includeFontPadding="false"
                android:text="OK" android:textColor="@color/brass_ink" android:textSize="11sp" />
            <TextView android:id="@+id/where" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="9dp" android:fontFamily="@font/mukta_semibold" android:textColor="@color/ivory"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginEnd="56dp" android:layout_marginTop="34dp"
        android:gravity="end" android:orientation="vertical">
        <TextClock android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/rozha_one" android:format12Hour="h:mm a" android:format24Hour="H:mm"
            android:textColor="@color/ivory" android:textSize="24sp" />
        <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/mukta_medium" android:textColor="@color/ivory_dim" android:textSize="13sp" />
    </LinearLayout>

    <!-- The rows. Their column slides so the row he's on always sits at the same height. -->
    <FrameLayout android:id="@+id/rowsViewport" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="286dp" android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:clipChildren="false" android:orientation="vertical" />
    </FrameLayout>

    <TextView android:id="@+id/note" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginEnd="56dp" android:layout_marginTop="96dp"
        android:background="@drawable/note_pill" android:fontFamily="@font/mukta_semibold" android:paddingBottom="7dp"
        android:paddingEnd="16dp" android:paddingStart="16dp" android:paddingTop="7dp" android:textColor="@color/brass_ink"
        android:textSize="14sp" android:visibility="gone" />

    <FrameLayout android:id="@+id/welcome" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/night" android:visibility="gone">
        <TextView android:id="@+id/hello" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:alpha="0" android:fontFamily="@font/rozha_one"
            android:textColor="@color/ivory" android:textSize="58sp" />
    </FrameLayout>
</FrameLayout>
