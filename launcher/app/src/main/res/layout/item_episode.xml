<?xml version="1.0" encoding="utf-8"?>
<!-- One YouTube episode (Podcasts): its thumbnail at 16:9 with the channel over its corner, and the episode's
     title under it. As tall as a poster, so the row keeps one height; twice as wide. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="180dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/poster_bg"
    android:foreground="@drawable/poster_ring"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/posterImage"
        android:layout_width="match_parent"
        android:layout_height="135dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/posterChannel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="109dp"
        android:maxWidth="220dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/rating_bg"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#E6FFFFFF"
        android:textSize="10sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 600" />

    <TextView
        android:id="@+id/posterTitle"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="135dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingMultiplier="0.95"
        android:textColor="#D9FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit" />

    <TextView
        android:id="@+id/posterRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</FrameLayout>
